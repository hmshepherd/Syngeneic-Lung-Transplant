options(future.globals.maxSize= 891289600)
fb.list <- lapply(fb.split, SCTransform, vars.to.regress = "percent.mt")
features  <- SelectIntegrationFeatures(fb.list, nfeatures = 3000)
fb.list <- PrepSCTIntegration(fb.list, anchor.features = features)
anchors <- FindIntegrationAnchors(fb.list, normalization.method = "SCT", anchor.features = features)
fb.int <- IntegrateData(anchorset = anchors, normalization.method = "SCT", k.weight = 50)
fb.int <- RunPCA(fb.int)
fb.int <- RunUMAP(fb.int, reduction = "pca", dims = 1:10)
fb.int <- FindNeighbors(fb.int, dims = 1:10)
fb.int <- FindClusters(fb.int, dims = 1:10)
fb.int <- RunTSNE(object = fb.int, features = VariableFeatures(object = fb.int), reduction.key = 'sctSNE_', reduction.name = 'sctsne')

